#!/usr/bin/env python3
"""Запуск MCP-сервера kb (stdio): python3 <плагин>/bin/kb-mcp"""
import os
import sys

if sys.version_info < (3, 9):
    sys.stderr.write("kb: нужен Python 3.9 или новее, а запущен %d.%d. "
                     "На Mac установите инструменты разработчика Apple (команда xcode-select --install) "
                     "или Python с python.org.\n" % sys.version_info[:2])
    sys.exit(1)

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from kb_mcp.server import main  # noqa: E402

sys.exit(main())
