#!/usr/bin/env bash
# ai-movie-company launcher: runs the pipeline engine (`python -m vp <command> ...`).
#
# First run creates a private virtualenv and installs the pinned, hash-checked dependencies:
#   <data>/venv-<X.Y>   data = $VP_RUNTIME_DIR, else $CLAUDE_PLUGIN_DATA, else ~/.ai_video_pipeline/runtime
#   pip install --require-hashes --only-binary=:all: --no-deps -r requirements.lock
# The venv is rebuilt when requirements.lock or the Python minor version changes, or when it is
# broken. Bootstrap messages go to stderr; stdout belongs to the engine.
#
# Overrides: VP_PYTHON=<interpreter> runs the engine with that interpreter as is (no venv; dev repo:
# VP_PYTHON=.venv/bin/python). Python >= 3.12 is required.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

say() { echo "ai-movie-company: $*" >&2; }

# install.sh puts Python and ffmpeg into ~/.local/bin; Claude Desktop sessions may not have it on PATH
export PATH="$HOME/.local/bin:$PATH"

if [ -n "${VP_PYTHON:-}" ]; then
  exec "$VP_PYTHON" -m vp "$@"     # dev: bytecode caches allowed
fi

PY=""
# macOS: /usr/bin/python3 is a stub until Apple's command line tools are installed; calling it then
# pops Apple's "install developer tools" window. While the tools are missing, the unversioned
# `python3` is not tried at all (every real Python 3.12+ also has its versioned name).
NO_STUBS=""
if [ "$(uname -s)" = "Darwin" ] && ! xcode-select -p >/dev/null 2>&1; then NO_STUBS=1; fi
for cand in python3.14 python3.13 python3.12 python3; do
  if [ -n "$NO_STUBS" ] && [ "$cand" = python3 ]; then continue; fi
  if command -v "$cand" >/dev/null 2>&1 \
     && "$cand" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
    PY="$(command -v "$cand")"
    break
  fi
done
if [ -z "$PY" ]; then
  say "Python 3.12 or newer is required (macOS: ask Claude to run the plugin installer again; Linux: your package manager)."
  exit 3
fi

PYVER="$("$PY" -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")')"
DATA="${VP_RUNTIME_DIR:-${CLAUDE_PLUGIN_DATA:-$HOME/.ai_video_pipeline/runtime}}"
VENV="$DATA/venv-$PYVER"
LOCKFILE="$ROOT/requirements.lock"
WANT="$("$PY" -c 'import hashlib, sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest() + "-" + sys.argv[2])' "$LOCKFILE" "$PYVER")"
STAMP="$VENV/.vp-lock-sha256"

venv_ok() {
  [ -x "$VENV/bin/python" ] \
    && [ "$(cat "$STAMP" 2>/dev/null || true)" = "$WANT" ] \
    && "$VENV/bin/python" -c 'import yaml' >/dev/null 2>&1
}

bootstrap() {
  guard="$DATA/.bootstrap.lock"
  local waited=0
  # Keep the same inode for all contenders. FD 9 holds the advisory lock across
  # pip and venv creation, even if a child outlives a killed launcher.
  while true; do
    if "$PY" - "$guard" "$$" <<'PY'
import fcntl
import os
import sys
from pathlib import Path

guard = Path(sys.argv[1])
owner_file = guard / "pid"
try:
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    sys.exit(75)


def owner_is_alive():
    try:
        owner = int(owner_file.read_text())
        if owner <= 0:
            return False
        os.kill(owner, 0)
    except (FileNotFoundError, ValueError, OverflowError, ProcessLookupError):
        return False
    except PermissionError:
        pass  # the PID exists, but we cannot signal it
    return True


if guard.exists():
    if owner_is_alive():
        fcntl.flock(9, fcntl.LOCK_UN)
        sys.exit(75)
    # An empty guard can be left by the old launcher or by an interrupted mkdir.
    owner_file.unlink(missing_ok=True)
    guard.rmdir()
guard.mkdir(mode=0o700)
owner_file.write_text(sys.argv[2] + "\n")
PY
    then
      break
    elif [ "$?" -ne 75 ]; then
      say "could not acquire bootstrap lock at $guard."
      exit 3
    fi
    if [ "$waited" -eq 0 ]; then
      say "waiting for another bootstrap holding $guard."
    fi
    if [ "$waited" -ge 600 ]; then
      say "another bootstrap holds $guard for 10 minutes; remove it if no install is running."
      exit 3
    fi
    sleep 2; waited=$((waited + 2))
  done
  trap 'release_bootstrap_lock' EXIT
  if venv_ok; then release_bootstrap_lock; return 0; fi  # done meanwhile
  local tmp="$VENV.tmp.$$"
  say "first run: creating $VENV and installing pinned dependencies from PyPI (hash-checked)..."
  "$PY" -m venv "$tmp"
  if ! "$tmp/bin/python" -m pip install --disable-pip-version-check --no-input -q \
        --timeout 15 --retries 2 \
        --require-hashes --only-binary=:all: --no-deps -r "$LOCKFILE" >&2; then
    rm -rf "$tmp"
    say "dependency install failed (network, or no wheel for this Python/platform in requirements.lock)."
    exit 3
  fi
  echo "$WANT" > "$tmp/.vp-lock-sha256"
  rm -rf "$VENV"
  mv "$tmp" "$VENV"
  release_bootstrap_lock
  say "runtime ready ($VENV)."
}

release_bootstrap_lock() {
  rm -f "$guard/pid" && rmdir "$guard" 2>/dev/null || true
  trap - EXIT
}

if ! venv_ok; then
  mkdir -p "$DATA"
  bootstrap 9>>"$DATA/.bootstrap.flock"
fi
export VP_VENV="$VENV"
export PYTHONDONTWRITEBYTECODE=1    # no caches inside the versioned plugin folder
exec "$VENV/bin/python" -m vp "$@"
