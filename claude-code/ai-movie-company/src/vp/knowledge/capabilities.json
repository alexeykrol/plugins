{
  "_about": "Capability registry for the scenario tree (vp.scenarios). One entry per capability: what it is, who provides it, how its presence is detected, whether the engine has it today. Codes follow docs/SCENARIOS.md section 2 (letters kept as values; keys are ASCII). Detection never reads secret values: only whether an env var is set or a file exists. Status: built = works today; partial = works in a reduced form (counted as available); planned = not built yet (another adapter will flip it to built and set `command`).",
  "groups": {
    "claude": {
      "name": {
        "ru": "Claude (подписка)",
        "en": "Claude (subscription)"
      },
      "free": true,
      "assumed": true,
      "always": true,
      "note": "the model judgment of the session itself and local code; always present"
    },
    "extras": {
      "name": {
        "ru": "набор для анимации (Node, Chrome, Remotion)",
        "en": "animation pack (Node, Chrome, Remotion)"
      },
      "free": true,
      "assumed": true,
      "detect": {
        "extras": true
      },
      "note": "free local install (`vp extras install`); assumed present in `--services none` and in the matrix"
    },
    "youtube": {
      "name": {
        "ru": "YouTube (вход через Google)",
        "en": "YouTube (Google login)"
      },
      "free": true,
      "assumed": true,
      "detect": {
        "config_file": "youtube.token_path"
      },
      "note": "free connection (`vp youtube authorize`); assumed present in `--services none` and in the matrix"
    },
    "elevenlabs": {
      "name": {
        "ru": "ElevenLabs",
        "en": "ElevenLabs"
      },
      "free": false,
      "detect": {
        "env": [
          "ELEVENLABS_API_KEY",
          "XI_API_KEY"
        ],
        "keys": [
          "elevenlabs"
        ]
      },
      "note": "the person's own ElevenLabs API key, saved once (`vp keys set elevenlabs --from-clipboard`) or env; one key serves recognition, voice and music (music: paid ElevenLabs plans only); no connector, no restart. The claude.ai connector is only a fallback when there is no key — the skill then adds `elevenlabs` itself"
    },
    "images": {
      "name": {
        "ru": "генерация картинок",
        "en": "image generation"
      },
      "free": false,
      "detect": {
        "env": [
          "OPENAI_API_KEY",
          "GEMINI_API_KEY",
          "GOOGLE_API_KEY"
        ],
        "keys": [
          "gemini",
          "openai"
        ]
      },
      "note": "`vp keys set gemini|openai --from-clipboard`"
    },
    "video": {
      "name": {
        "ru": "генерация видеоклипов",
        "en": "AI video clips"
      },
      "free": false,
      "detect": {
        "env": [
          "RUNWAYML_API_SECRET",
          "FAL_KEY",
          "GEMINI_API_KEY",
          "LUMAAI_API_KEY"
        ]
      },
      "note": "provisional lookup: no video adapter yet"
    },
    "stock": {
      "name": {
        "ru": "сток (Pexels, Pixabay)",
        "en": "stock (Pexels, Pixabay)"
      },
      "free": true,
      "detect": {
        "env": [
          "PEXELS_API_KEY",
          "PIXABAY_API_KEY"
        ],
        "keys": [
          "pexels",
          "pixabay"
        ]
      },
      "note": "free keys, but the person has to get one; provisional lookup: the stock adapter (in progress) defines the final one"
    },
    "avatar": {
      "name": {
        "ru": "цифровой ведущий (HeyGen)",
        "en": "digital presenter (HeyGen)"
      },
      "free": false,
      "detect": {
        "env": [
          "HEYGEN_API_KEY"
        ]
      },
      "note": "provisional lookup: no avatar adapter yet"
    },
    "platforms": {
      "name": {
        "ru": "площадки кроме YouTube",
        "en": "platforms other than YouTube"
      },
      "free": true,
      "detect": {
        "env": []
      },
      "note": "Instagram, TikTok, Facebook, LinkedIn — no adapter yet"
    }
  },
